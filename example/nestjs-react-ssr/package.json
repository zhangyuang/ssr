{
  "name": "nestjs-react-ssr",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-router-dom": "^5.1.2",
    "reflect-metadata": "^0.1.13",
    "ssr-common-utils": "^7.0.0",
    "ssr-core": "^7.0.0",
    "valtio": "^1.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-router-dom": "^5.1.3",
    "ssr": "^7.0.0",
    "ssr-plugin-nestjs": "^7.0.0",
    "ssr-plugin-react": "^7.0.0",
    "ssr-types": "^7.0.0",
    "ssr-vite": "^7.0.0",
    "ssr-webpack": "^7.0.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prod": "ssr build && NODE_ENV=production node dist/main.js",
    "prod:vite": "ssr build --vite && NODE_ENV=production node dist/main.js",
    "start": "ssr start",
    "start:vite": "ssr start --vite",
    "build": "ssr build",
    "build:o": "ssr build --optimize",
    "build:vite": "ssr build --vite",
    "deploy": "ssr build && ssr deploy",
    "lint": "biome format --diagnostic-level error",
    "lint:fix": "biome format --diagnostic-level error --write"
  }
}
