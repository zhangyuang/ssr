{
  "name": "nestjs-vue3-ssr",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^10.2.7",
    "@nestjs/core": "^10.2.7",
    "@nestjs/platform-express": "^10.2.7",
    "@vue/server-renderer": "^3.0.7",
    "pinia": "^2.0.13",

    "reflect-metadata": "^0.1.13",
    "ssr-common-utils": "workspace:*",
    "ssr-core": "workspace:*",
    "ssr-hoc-vue3": "workspace:*",
    "swiper": "6.7.5",
    "vue": "^3.0.0",
    "vue-router": "^4.2.4",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^10.1.18",
    "ssr": "workspace:*",
    "ssr-plugin-nestjs": "workspace:*",
    "ssr-plugin-vue3": "workspace:*",
    "ssr-webpack": "workspace:*",
    "ssr-vite": "workspace:*",
    "ssr-types": "workspace:*",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prod": "ssr build && NODE_ENV=production node dist/main.js",
    "prod:vite": "ssr build --vite && NODE_ENV=production node dist/main.js",
    "start": "ssr start",
    "start:vite": "ssr start --vite",
    "build": "ssr build",
    "build:o": "ssr build --optimize",
    "build:vite": "ssr build --vite",
    "deploy": "ssr build && ssr deploy",
    "lint": "biome format --diagnostic-level error",
    "lint:fix": "biome format --diagnostic-level error --write"
  }
}