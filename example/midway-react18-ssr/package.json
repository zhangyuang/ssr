{
  "name": "midway-react18-ssr",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@midwayjs/bootstrap": "^3.0.0",
    "@midwayjs/core": "^3.0.0",
    "@midwayjs/decorator": "^3.0.0",
    "@midwayjs/koa": "^3.0.0",
    "@midwayjs/logger": "^3.0.0",
    "koa-static-cache": "^5.1.4",
    "pm2": "^4.5.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^5.1.2",
    "ssr-common-utils": "workspace:*",
    "ssr-core": "workspace:*",
    "valtio": "^1.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@midwayjs/mock": "^3.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.1.3",
    "ssr": "workspace:*",
    "ssr-plugin-midway": "workspace:*",
    "ssr-plugin-react": "workspace:*",
    "ssr-types": "workspace:*",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "prod": "ssr build && pm2 start pm2.config.js",
    "prod:vite": "ssr build --vite && pm2 start pm2.config.js",
    "stop": "pm2 stop pm2.config.js",
    "start": "ssr start",
    "start:vite": "ssr start --vite",
    "build": "ssr build",
    "build:o": "ssr build --optimize",
    "build:vite": "ssr build --vite",
    "deploy": "ssr build && ssr deploy",
    "lint": "biome format --diagnostic-level error",
    "lint:fix": "biome format --diagnostic-level error --write"
  }
}
