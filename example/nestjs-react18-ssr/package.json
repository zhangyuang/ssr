{
  "name": "nestjs-react18-ssr",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^10.2.7",
    "@nestjs/core": "^10.2.7",
    "@nestjs/platform-express": "^10.2.7",
    "pm2": "^4.5.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router": "5.3.4",
    "react-router-dom": "^5.1.2",
    "reflect-metadata": "^0.1.13",
    "ssr-common-utils": "workspace:*",
    "ssr-core": "workspace:*",
    "valtio": "^1.11.2"
  },
 "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^10.1.18",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-router-dom": "^5.1.3",
    "typescript": "^5.0.0",
    "ssr": "workspace:*",
    "ssr-plugin-nestjs": "workspace:*",
    "ssr-plugin-react": "workspace:*",
    "ssr-types": "workspace:*",
    "ssr-vite": "workspace:*",
    "ssr-webpack": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prod": "ssr build && pm2 start pm2.config.js",
    "prod:vite": "ssr build --vite && pm2 start pm2.config.js",
    "stop": "pm2 stop pm2.config.js",
    "start": "ssr start",
    "start:vite": "ssr start --vite",
    "build": "ssr build",
    "build:o": "ssr build --optimize",
    "build:vite": "ssr build --vite",
    "deploy": "ssr build && ssr deploy",
    "lint": "biome format --diagnostic-level error",
    "lint:fix": "biome format --diagnostic-level error --write"
  }
}
