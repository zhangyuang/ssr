{
  "name": "nestjs-react18-ssr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ssr start",
    "start:vite": "ssr start --tool vite",
    "start:rspack": "ssr start --tool rspack",
    "prod": "ssr build && NODE_ENV=production node dist/main.js",
    "prod:vite": "ssr build --tool vite && NODE_ENV=production node dist/main.js",
    "prod:rspack": "ssr build --tool rspack && NODE_ENV=production node dist/main.js",
    "lint": "oxfmt --check .",
    "lint:fix": "oxfmt ."
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^5.1.2",
    "reflect-metadata": "^0.1.13",
    "ssr-common-utils": "^7.0.0",
    "ssr-core": "^7.0.0",
    "valtio": "^1.13.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-router-dom": "^5.1.3",
    "oxfmt": "latest",
    "ssr": "^7.0.0",
    "ssr-plugin-nestjs": "^7.0.0",
    "ssr-plugin-react": "^7.0.0",
    "ssr-rspack": "^7.0.0",
    "ssr-types": "^7.0.0",
    "ssr-vite": "^7.0.0",
    "ssr-webpack": "^7.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
