{
  "name": "ssr-vite",
  "version": "6.2.17",
  "description": "vite config for serverless ssr",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "concurrently \"tsc -p ./tsconfig.cjs.json \" \" tsc -p ./tsconfig.esm.json\"",
    "watch": "concurrently \"tsc -w -p ./tsconfig.cjs.json \" \"tsc -w -p ./tsconfig.esm.json \""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuang/ssr.git"
  },
  "keywords": [
    "vite",
    "serverless",
    "ssr",
    "react",
    "vue"
  ],
  "author": "zhangyuang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhangyuang/ssr/issues"
  },
  "homepage": "https://github.com/zhangyuang/ssr#readme",
  "dependencies": {
    "rollup-plugin-visualizer": "^5.12.0"
  },
  "devDependencies": {
    "ssr-types": "^6.2.3"
  }
}
