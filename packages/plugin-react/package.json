{
  "name": "ssr-plugin-react",
  "version": "7.0.1-beta.0",
  "description": "plugin-react for ssr",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "concurrently \"tsc -p ./tsconfig.cjs.json \" \" tsc -p ./tsconfig.esm.json\"",
    "watch": "concurrently \"tsc -w -p ./tsconfig.cjs.json \" \"tsc -w -p ./tsconfig.esm.json \""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuang/ssr.git"
  },
  "keywords": [
    "cli",
    "serverless",
    "ssr",
    "react",
    "vue"
  ],
  "author": "zhangyuang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhangyuang/ssr/issues"
  },
  "engines": {
    "node": ">=14.17.0"
  },
  "homepage": "https://github.com/zhangyuang/ssr#readme",
  "dependencies": {
    "ssr-common-utils": "workspace:*",
    "@vitejs/plugin-react-oxc": "^0.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "babel-preset-react-app": "^10.0.0",
    "ssr-hoc-react": "workspace:*",
    "react-refresh": "^0.12.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "valtio": "^1.13.2"
  },
  "peerDependencies": {
    "react": ">=17.0.1",
    "react-dom": ">=17.0.0",
    "react-router": "^5.1.8",
    "react-router-dom": "^5.0.0",
    "webpack": "^4.0.0"
  },
  "devDependencies": {
    "@types/react18": "npm:@types/react@^18.0.0",
    "@types/react-dom18": "npm:@types/react-dom@^18.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-router-dom": "^5.1.3",
    "@types/webpack": "^4.41.10",
    "concurrently": "^5.1.0",
    "ssr-types": "workspace:*",
    "ssr-webpack": "workspace:*",
    "ssr-vite": "workspace:*"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    }
  }
}
