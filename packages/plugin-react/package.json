{
  "name": "ssr-plugin-react",
  "version": "7.0.0",
  "description": "plugin-react for ssr",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "concurrently \"tsc -p ./tsconfig.cjs.json \" \" tsc -p ./tsconfig.esm.json\"",
    "watch": "concurrently \"tsc -w -p ./tsconfig.cjs.json \" \"tsc -w -p ./tsconfig.esm.json \""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuang/ssr.git"
  },
  "keywords": [
    "cli",
    "serverless",
    "ssr",
    "react",
    "vue"
  ],
  "author": "zhangyuang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhangyuang/ssr/issues"
  },
  "engines": {
    "node": ">=14.17.0"
  },
  "homepage": "https://github.com/zhangyuang/ssr#readme",
  "dependencies": {
    "ssr-common-utils": "workspace:*",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@vitejs/plugin-react": "^1.3.2",
    "babel-preset-react-app": "^10.0.0",
    "react": "^17.0.1",
    "react-dev-utils": "^11.0.4",
    "react-dom": "^17.0.0",
    "react-refresh": "^0.12.0",
    "react-router": "^5.2.1",
    "react-router-dom": "^5.1.2",
    "ssr-hoc-react": "workspace:*",
    "valtio": "^1.11.2"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-router-dom": "^5.1.3",
    "@types/webpack": "^4.41.10",
    "concurrently": "^5.1.0",
    "ssr-types": "workspace:*",
    "ssr-webpack": "workspace:*",
    "ssr-vite": "workspace:*"
  }
}
