{
  "name": "ssr-plugin-vue",
  "version": "7.0.4",
  "description": "plugin-vue for ssr",
  "keywords": [
    "cli",
    "react",
    "serverless",
    "ssr",
    "vue"
  ],
  "homepage": "https://github.com/zhangyuang/ssr#readme",
  "bugs": {
    "url": "https://github.com/zhangyuang/ssr/issues"
  },
  "license": "MIT",
  "author": "zhangyuang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuang/ssr.git"
  },
  "sideEffects": false,
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "scripts": {
    "build": "concurrently \"tsc -p ./tsconfig.cjs.json \" \" tsc -p ./tsconfig.esm.json\"",
    "watch": "concurrently \"tsc -w -p ./tsconfig.cjs.json \" \"tsc -w -p ./tsconfig.esm.json \""
  },
  "dependencies": {
    "ssr-common-utils": "workspace:*",
    "ssr-types": "workspace:*",
    "ssr-webpack": "workspace:*",
    "vue": "^2.0.0",
    "vue-loader": "^15.0.0",
    "vue-router": "^3.6.5",
    "vue-server-renderer": "^2.7.8",
    "vue-template-compiler": "^2.7.8",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@types/webpack": "^4.41.10",
    "concurrently": "^5.1.0",
    "ssr-types": "workspace:*",
    "ssr-webpack": "workspace:*"
  },
  "engines": {
    "node": ">=14.17.0"
  }
}
