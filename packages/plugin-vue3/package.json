{
  "name": "ssr-plugin-vue3",
  "version": "7.0.3",
  "description": "plugin-vue3 for ssr",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "concurrently \"tsc -p ./tsconfig.cjs.json \" \" tsc -p ./tsconfig.esm.json\"",
    "watch": "concurrently \"tsc -w -p ./tsconfig.cjs.json \" \"tsc -w -p ./tsconfig.esm.json \""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuang/ssr.git"
  },
  "keywords": [
    "cli",
    "serverless",
    "ssr",
    "vue",
    "react"
  ],
  "author": "zhangyuang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhangyuang/ssr/issues"
  },
  "engines": {
    "node": ">=14.17.0"
  },
  "homepage": "https://github.com/zhangyuang/ssr#readme",
  "dependencies": {
    "ssr-common-utils": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "@vue/babel-plugin-jsx": "^1.0.3",
    "@vue/compiler-sfc": "^3.0.7",
    "vue": "^3.0.0",
    "vue-loader": "^17.0.0",
    "vue-router": "^4.2.4",
    "vuex": "^4.0.0",
    "@vue/server-renderer": "^3.0.7"
  },
  "devDependencies": {
    "ssr-types": "workspace:*",
    "ssr-webpack": "workspace:*",
    "@types/webpack": "^4.41.10",
    "concurrently": "^5.1.0"
  }
}
