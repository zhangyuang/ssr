{
  "name": "ssr-webpack",
  "version": "7.0.5",
  "description": "webpack config for serverless ssr",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "concurrently \"tsc -p ./tsconfig.cjs.json \" \" tsc -p ./tsconfig.esm.json\"",
    "watch": "concurrently \"tsc -w -p ./tsconfig.cjs.json \" \"tsc -w -p ./tsconfig.esm.json \""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyuang/ssr.git"
  },
  "keywords": [
    "webpack",
    "serverless",
    "ssr",
    "react",
    "vue"
  ],
  "author": "zhangyuang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhangyuang/ssr/issues"
  },
  "homepage": "https://github.com/zhangyuang/ssr#readme",
  "dependencies": {
    "@types/semver": "^7.3.13",
    "@types/webpack": "^4.41.8",
    "webpack": "^4.0.0",
    "webpack-dev-server-ssr": "^3.10.12",
    "@babel/core": "^7.0.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.16.5",
    "@babel/plugin-proposal-optional-chaining": "^7.16.5",
    "@babel/plugin-transform-runtime": "^7.9.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-typescript": "^7.12.13",
    "@babel/runtime": "^7.12.13",
    "@rollup/plugin-babel": "^5.3.0",
    "babel-loader": "^8.0.4",
    "babel-plugin-import": "1.13.3",
    "core-js": "^3.6.4",
    "css-loader": "^5.2.7",
    "file-loader": "^6.2.0",
    "less": "^4.1.1",
    "less-loader": "^7.3.0",
    "optimize-css-assets-webpack-plugin": "^6.0.0",
    "ora": "^4.0.4",
    "postcss": "^8.0.0",
    "postcss-discard-comments": "^5.0.0",
    "postcss-flexbugs-fixes": "^5.0.0",
    "postcss-loader": "^4.0.0",
    "postcss-preset-env": "7.6.0",
    "postcss-safe-parser": "^6.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "semver": "^7.3.8",
    "ssr-common-utils": "workspace:*",
    "ssr-deepclone": "^1.0.0",
    "ssr-mini-css-extract-plugin": "^1.6.5",
    "ssr-serialize-javascript": "^6.0.0",
    "ssr-types": "workspace:*",
    "ssr-webpack4": "^4.46.2",
    "terser-webpack-plugin": "^2.3.5",
    "unplugin-auto-import": "^0.12.1",
    "unplugin-vue-components": "^0.22.12",
    "url-loader": "^4.1.1",
    "webpack-bundle-analyzer": "^3.6.1",
    "webpack-chain": "^6.4.0",
    "rspack-chain": "^1.0.0",
    "webpack-manifest-plugin": "^2.2.0",
    "webpackbar": "^5.0.0-3"
  },
  "devDependencies": {
    "ssr-types": "workspace:*"
  }
}
